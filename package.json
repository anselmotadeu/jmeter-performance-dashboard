    "@types/react-dom": "^19",
    "@types/xml-crypto": "^1.4.6",
    "cypress": "^15.21.1",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporter": "^4.4.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  }
