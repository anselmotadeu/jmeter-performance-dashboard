# =============================================
# PERFORMANCE DASHBOARD — VARIÁVEIS DE AMBIENTE
# =============================================
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA comite o arquivo .env.local no repositório.

# ---- Autenticação (obrigatório em produção) ----
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=cole-aqui-uma-string-aleatoria-de-32-chars

# URL base do app (obrigatório em produção)
NEXTAUTH_URL=https://seu-dominio.com

# ---- Google OAuth (recomendado) ----
# Crie em: https://console.cloud.google.com → APIs & Services → Credentials
# Adicione http://localhost:3000/api/auth/callback/google (dev) e sua URL de produção
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Credenciais simples (alternativa ao Google) ----
# Útil para equipes internas sem Google OAuth configurado
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=troque-por-senha-segura

# ---- Modo de desenvolvimento ----
# Defina como 'true' para desativar autenticação localmente (NUNCA em produção)
SKIP_AUTH=false
